// Esquema de la base de CLOTH TO GO.
//
// Postgres en los TRES sitios (desarrollo, CI y producción). Se descartó dejar
// SQLite para probar: dos motores significan que las migraciones solo valen
// para uno y que las pruebas no ejercitan el motor real — la misma divergencia
// silenciosa que ya obligó a poner un guardarraíl al catálogo duplicado.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexión de la app. Con Supabase apunta al pooler (pgbouncer, puerto 6543).
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432), obligatoria para las migraciones: el pooler
  // no admite las sentencias preparadas que usa `prisma migrate`, y sin esto
  // falla con un error que no explica de dónde viene.
  directUrl = env("DIRECT_URL")
}

/// Tipos de línea del ledger. Son `enum` de verdad desde el paso a Postgres:
/// mientras la base fue SQLite iban como String porque Prisma no soporta enums
/// sobre ese motor, y la única defensa era el código. Ahora un tipo inventado
/// no entra ni por una consulta a mano.
enum ChargeType {
  RENTAL
  SHIPPING
  RETURN
  DEPOSIT_HOLD
  DEPOSIT_RELEASE
  LATE_PENALTY
  DISCOUNT
  ADJUSTMENT
}

/// Estado de cobro de una línea. VOID = anulada, no cuenta para nada.
enum ChargeStatus {
  PENDING
  SETTLED
  VOID
}

/// Cómo se movió el dinero de la línea.
enum ChargeMethod {
  CASH
  CARD
}

/// Prenda del catálogo. Refleja los campos que ya usa el frontend (js/data.js).
/// Segunda mano y única: `disponibles` es 1 por defecto.
/// No guarda precio ni depósito: ambos se derivan de `value` (coste de
/// reposición) mediante rentalPrice()/depositFor() en js/data.js.
model Product {
  id          Int    @id
  name        String
  cat         String
  value       Float
  stars       Int
  /// Talla en la escala que le corresponda: letras para la ropa (XS…XXL) y
  /// número EU para el calzado ("39"). Va como texto por eso mismo — son dos
  /// escalas distintas, y un Int dejaría fuera la mitad del catálogo.
  size        String
  /// Color dominante, como clave de la paleta cerrada del frontend
  /// (COLOR_ORDER en js/data.js): "negro", "beige", … No es texto libre — el
  /// filtro compara por igualdad, y "azul marino" no coincidiría con "azul".
  color       String
  disponibles Int    @default(1)
  material    String
  weightKg    Float
  /// Fotos de la prenda (["img/products/1.webp", …]), de la portada a la
  /// última. Lista de verdad desde el paso a Postgres: con SQLite se guardaba
  /// serializado como JSON y la API tenía que deshacerlo en cada respuesta.
  imgs        String[]
  desc        String
  orderItems  OrderItem[]
  charges     Charge[]

  @@map("products")
}

/// Usuario autenticado con Google. `googleSub` es el identificador estable
/// que Google garantiza (el email puede cambiar; el sub no). Se registra
/// (upsert) la primera vez que /api/auth/google verifica su ID token, y se
/// actualiza en cada login por si el nombre/foto cambiaron en Google.
model User {
  id        Int      @id @default(autoincrement())
  googleSub String   @unique
  email     String
  name      String
  picture   String?
  createdAt DateTime @default(now())
  orders    Order[]

  @@map("users")
}

/// Alquiler confirmado.
///
/// NO guarda `total`. El importe cobrado es un hecho histórico y no puede
/// recalcularse cuando cambian las reglas: si mañana sube SHIPPING_FEE, un
/// `total` derivado haría mentir a todos los pedidos pasados. El dinero vive
/// entero en `charges`, y el total es su suma.
///
/// Tampoco guarda el estado de pago (el `settled`/`pending` del frontend): eso
/// también se deriva del ledger — un pedido está saldado cuando no le queda
/// ninguna línea PENDING. Lo único que sí es un hecho propio del pedido y no de
/// una línea es la anulación, y por eso `cancelledAt` sí existe.
///
/// Las fechas van como texto `YYYY-MM-DD` a propósito, igual que en el
/// frontend: son días de calendario locales de Guayaquil, no instantes. Un
/// DateTime las convertiría a UTC y en UTC−5 el alquiler empezaría el día
/// anterior.
model Order {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  /// Primer día del alquiler (`YYYY-MM-DD`).
  start       String
  /// Día de devolución (`YYYY-MM-DD`).
  end         String
  /// Cómo lo recibe: `ship` | `pickup` (DELIVERY en pricing.js).
  delivery    String
  /// Cómo lo devuelve: `home` | `store` (RETURN_TO en pricing.js).
  ret         String
  /// Dirección de envío; null cuando se retira en el local.
  shipAddr    String?
  /// Dirección de retiro; null cuando se devuelve en el local.
  retAddr     String?
  /// Método de pago: `cash` | `credit` | `debit` (PAY_METHOD del frontend).
  pay         String
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?
  items       OrderItem[]
  charges     Charge[]

  @@index([userId])
  @@map("orders")
}

/// Qué prendas lleva el pedido. Sin importes: el dinero de cada prenda es su
/// línea RENTAL en `charges`, y duplicarlo aquí sería tener dos precios para lo
/// mismo — exactamente lo que el ledger viene a evitar.
///
/// Una prenda es única (`disponibles` = 1), así que no hay cantidad: la misma
/// prenda no puede aparecer dos veces en el mismo pedido, y el índice único lo
/// impone en la base en vez de confiarlo al código.
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

/// Línea del libro de cargos. **Inmutable**: cambiar el modo de devolución no
/// edita la línea anterior, añade un ADJUSTMENT. Así el historial explica por
/// sí solo por qué el cliente pagó lo que pagó, que es justo lo que hace falta
/// cuando alguien reclama.
///
/// `amountCents` en centavos ENTEROS, misma decisión que `cents()` en
/// js/state.js: sumar en float arrastra un centavo de deriva, y en la base ese
/// error queda escrito. Negativo = a favor del cliente.
///
/// `type`, `status` y `method` son enums de la base. Las constantes
/// CHARGE_TYPE / CHARGE_STATUS / CHARGE_METHOD de src/ledger.js siguen siendo
/// el vocabulario del código, pero ya no son la única defensa: la base rechaza
/// cualquier valor fuera de la lista.
model Charge {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id])
  type        ChargeType
  amountCents Int
  status      ChargeStatus
  /// Null en las líneas que no mueven dinero por sí solas.
  method      ChargeMethod?
  /// Prenda a la que corresponde la línea, cuando la hay (las RENTAL). El
  /// depósito no la lleva: tiene tope POR PEDIDO, así que no es repartible
  /// entre prendas sin inventarse un reparto.
  ///
  /// Va con relación de verdad y no como un Int suelto: un desglose que apunta
  /// a una prenda inexistente es un cargo que nadie puede explicar, y ese es
  /// justo el momento en que hace falta poder explicarlo.
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id])
  /// Por qué existe esta línea, en lenguaje humano: "cambio de devolución:
  /// local → domicilio". Es lo que se le enseña a un cliente que reclama.
  note        String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@map("charges")
}
