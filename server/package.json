{
  "name": "cloth-to-go-server",
  "version": "0.1.0",
  "private": true,
  "description": "API backend de CLOTH TO GO (Fastify + Prisma + Postgres).",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force --skip-seed && node prisma/seed.js",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@prisma/client": "^6.1.0",
    "fastify": "^5.2.0",
    "google-auth-library": "^10.9.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0"
  }
}
