# Copia este archivo a .env y ajusta si hace falta.

# Postgres en los TRES sitios (desarrollo, CI y producción): dos motores
# significan que las migraciones solo valen para uno y que las pruebas no
# ejercitan el motor real.
#
# Conexión que usa la app. En Supabase es el POOLER (pgbouncer, puerto 6543):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clothtogo"

# Conexión DIRECTA (en Supabase, puerto 5432). La exigen las migraciones: el
# pooler no admite las sentencias preparadas de `prisma migrate` y falla con un
# error que no explica de dónde viene. En local suele ser la misma que arriba.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/clothtogo"

# Puerto del servidor.
PORT=3000

# Orígenes autorizados a leer la API, separados por comas.
# Vacío o ausente = se refleja cualquier origen (solo desarrollo).
# Producción, por ejemplo:  CORS_ORIGINS="https://clothtogo.app"
# CORS_ORIGINS="http://localhost:8000"

# Client ID de Google Cloud Console usado para verificar el ID token en
# POST /api/auth/google (audience). Debe ser EXACTAMENTE el mismo que usa el
# frontend en js/auth.js (GOOGLE_CLIENT_ID), o la verificación rechaza el token.
GOOGLE_CLIENT_ID="115840486389-f3vitcouhua5eckn3grn1gk9kqb7ccjs.apps.googleusercontent.com"

# `googleSub` del personal del local, separados por comas. Son los únicos que
# pueden confirmar un cobro en efectivo, liberar un depósito o cobrar un atraso:
# que entró dinero lo dice el negocio, nunca el cliente.
# Vacía o ausente = nadie es admin y esas rutas responden 403 a todo el mundo.
# ADMIN_SUBS="106...,111..."

# Asistente informativo de la web (POST /api/chat). Clave gratuita de Google AI
# Studio. Vacía o ausente = el asistente queda apagado y la web no muestra la
# burbuja. Ojo: en la capa gratuita Google puede usar los mensajes para mejorar
# sus modelos; por eso la web pide no compartir datos personales.
# GEMINI_API_KEY=""
# Modelo Flash de la capa gratuita (comprobar en AI Studio que siga gratis).
# GEMINI_MODEL="gemini-2.5-flash"
# Nombre de la fundación que muestran la web y el mensaje de disculpa.
# CHAT_FOUNDATION="Water Footprint Network"
# Límites: mensajes por minuto por IP y tope diario global (cuida la cuota).
# CHAT_PER_MINUTE=8
# CHAT_PER_DAY=1000
# Saltos de proxy de confianza para leer la IP real (en Render: 1).
# TRUST_PROXY=1
